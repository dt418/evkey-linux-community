[Unit]
Description=EVKey Linux Community uinput helper for UID %i
After=systemd-modules-load.service systemd-udevd.service
Wants=systemd-modules-load.service

[Service]
Type=simple
User=@EVKEY_INPUT_USER@
Group=@EVKEY_INPUT_USER@
ExecStart=/usr/bin/fcitx5-evkey-server --uid %i
Restart=on-failure
RestartSec=1
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
